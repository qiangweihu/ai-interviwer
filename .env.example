APP_ENV=production
DATA_DIR=/var/lib/ai-interviwer
MIMO_API_KEY=sk-replace-me
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
MAX_RESUME_BYTES=10485760
MAX_MODEL_CALLS_PER_HOUR=60
# Local faster-whisper ASR. The model is downloaded once into this directory;
# uploaded recordings are decoded in memory and never saved to DATA_DIR.
LOCAL_ASR_ENABLED=true
LOCAL_ASR_MODEL=small
LOCAL_ASR_MODEL_DIR=/var/lib/ai-interviwer/models
LOCAL_ASR_COMPUTE_TYPE=int8
LOCAL_ASR_LANGUAGE=zh
MAX_AUDIO_BYTES=15728640
MAX_AUDIO_SECONDS=180

# Practical coding/SQL tasks (fail closed until a private runner is ready).
PRACTICAL_RUNNER_ENABLED=false
PRACTICAL_RUNNER_URL=http://runner:8080
PRACTICAL_RUNNER_TOKEN=
PRACTICAL_MAX_RUNS_PER_TASK=10
PRACTICAL_MAX_SOURCE_CHARS=65536
RUNNER_MAX_CONCURRENCY=2
# Set only for local fictional-data tests; never enable in production.
MOCK_MIMO=false
